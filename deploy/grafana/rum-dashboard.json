{
  "title": "RUM — Real User Monitoring",
  "uid": "rum-overview",
  "schemaVersion": 39,
  "editable": true,
  "tags": ["rum", "web-vitals"],
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "query": "label_values(rum_pageview_total, service)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "path_group",
        "label": "Path group",
        "type": "query",
        "query": "label_values(rum_pageview_total{service=~\"$service\"}, path_group)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "title": "LCP p75",
      "description": "Largest Contentful Paint, 75th percentile over the last hour. Good < 2.5s, poor > 4s.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#0ca30c", "value": null },
              { "color": "#fab219", "value": 2500 },
              { "color": "#d03b3b", "value": 4000 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        { "expr": "histogram_quantile(0.75, sum by (le) (rate(web_vitals_lcp_milliseconds_bucket{service=~\"$service\", path_group=~\"$path_group\"}[1h])))", "legendFormat": "LCP p75" }
      ]
    },
    {
      "title": "INP p75",
      "description": "Interaction to Next Paint. Good < 200ms, poor > 500ms.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#0ca30c", "value": null },
              { "color": "#fab219", "value": 200 },
              { "color": "#d03b3b", "value": 500 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        { "expr": "histogram_quantile(0.75, sum by (le) (rate(web_vitals_inp_milliseconds_bucket{service=~\"$service\", path_group=~\"$path_group\"}[1h])))", "legendFormat": "INP p75" }
      ]
    },
    {
      "title": "CLS p75",
      "description": "Cumulative Layout Shift. Good < 0.1, poor > 0.25.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#0ca30c", "value": null },
              { "color": "#fab219", "value": 0.1 },
              { "color": "#d03b3b", "value": 0.25 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        { "expr": "histogram_quantile(0.75, sum by (le) (rate(web_vitals_cls_score_bucket{service=~\"$service\", path_group=~\"$path_group\"}[1h])))", "legendFormat": "CLS p75" }
      ]
    },
    {
      "title": "FCP p75",
      "description": "First Contentful Paint. Good < 1.8s, poor > 3s.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#0ca30c", "value": null },
              { "color": "#fab219", "value": 1800 },
              { "color": "#d03b3b", "value": 3000 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        { "expr": "histogram_quantile(0.75, sum by (le) (rate(web_vitals_fcp_milliseconds_bucket{service=~\"$service\", path_group=~\"$path_group\"}[1h])))", "legendFormat": "FCP p75" }
      ]
    },
    {
      "title": "TTFB p75",
      "description": "Time to First Byte. Good < 800ms, poor > 1.8s.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#0ca30c", "value": null },
              { "color": "#fab219", "value": 800 },
              { "color": "#d03b3b", "value": 1800 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        { "expr": "histogram_quantile(0.75, sum by (le) (rate(web_vitals_ttfb_milliseconds_bucket{service=~\"$service\", path_group=~\"$path_group\"}[1h])))", "legendFormat": "TTFB p75" }
      ]
    },

    {
      "title": "LCP p75 over time",
      "description": "Per service. The 2.5s / 4s guides are the Google good / poor thresholds.",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "pointSize": 8,
            "showPoints": "auto",
            "spanNulls": true,
            "thresholdsStyle": { "mode": "dashed" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "transparent", "value": null },
              { "color": "#fab219", "value": 2500 },
              { "color": "#d03b3b", "value": 4000 }
            ]
          }
        }
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "expr": "histogram_quantile(0.75, sum by (service, le) (rate(web_vitals_lcp_milliseconds_bucket{service=~\"$service\", path_group=~\"$path_group\"}[1h])))", "legendFormat": "{{service}}" }
      ]
    },
    {
      "title": "Page loads per hour",
      "description": "One increment per navigation beacon.",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 5 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "pointSize": 8,
            "showPoints": "auto",
            "spanNulls": true
          }
        }
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "expr": "sum by (service)(increase(rum_pageview_total{service=~\"$service\", path_group=~\"$path_group\"}[1h]))", "legendFormat": "{{service}}" }
      ]
    },

    {
      "title": "Browser share",
      "description": "Share of page loads in the selected window.",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 14 },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "chrome" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#3987e5" } }] },
          { "matcher": { "id": "byName", "options": "safari" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#d95926" } }] },
          { "matcher": { "id": "byName", "options": "firefox" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#199e70" } }] },
          { "matcher": { "id": "byName", "options": "edge" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#c98500" } }] },
          { "matcher": { "id": "byName", "options": "samsung" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#d55181" } }] },
          { "matcher": { "id": "byName", "options": "other" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#008300" } }] }
        ]
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "pieType": "donut",
        "displayLabels": ["name", "percent"],
        "legend": { "showLegend": true, "displayMode": "list", "placement": "right", "values": ["value"] },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        { "expr": "sum by (browser)(increase(rum_pageview_total{service=~\"$service\", path_group=~\"$path_group\"}[1h]))", "legendFormat": "{{browser}}" }
      ]
    },
    {
      "title": "OS share",
      "description": "Share of page loads in the selected window.",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 14 },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "windows" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#3987e5" } }] },
          { "matcher": { "id": "byName", "options": "macos" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#d95926" } }] },
          { "matcher": { "id": "byName", "options": "ios" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#199e70" } }] },
          { "matcher": { "id": "byName", "options": "android" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#c98500" } }] },
          { "matcher": { "id": "byName", "options": "linux" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#d55181" } }] },
          { "matcher": { "id": "byName", "options": "other" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#008300" } }] }
        ]
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "pieType": "donut",
        "displayLabels": ["name", "percent"],
        "legend": { "showLegend": true, "displayMode": "list", "placement": "right", "values": ["value"] },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        { "expr": "sum by (os)(increase(rum_pageview_total{service=~\"$service\", path_group=~\"$path_group\"}[1h]))", "legendFormat": "{{os}}" }
      ]
    },
    {
      "title": "Network (ASN) share — top 5",
      "description": "Visitor networks. The tail is folded into \"other\" so the slices still sum to all page loads. Note: rum_asn_total carries no path_group label, so the Path group filter does not narrow this panel.",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 14 },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "other" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#008300" } }] }
        ]
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "pieType": "donut",
        "displayLabels": ["name", "percent"],
        "legend": { "showLegend": true, "displayMode": "list", "placement": "right", "values": ["value"] },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        { "expr": "topk(5, sum by (asn)(increase(rum_asn_total{service=~\"$service\"}[1h])))", "legendFormat": "AS{{asn}}" },
        { "expr": "clamp_min(sum(increase(rum_asn_total{service=~\"$service\"}[1h])) - sum(topk(5, sum by (asn)(increase(rum_asn_total{service=~\"$service\"}[1h])))), 0)", "legendFormat": "other" }
      ]
    },

    {
      "title": "LCP p75 by path group",
      "description": "Which kinds of page are slow. Colored on the same good / poor thresholds as the tile above.",
      "type": "bargauge",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 22 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#0ca30c", "value": null },
              { "color": "#fab219", "value": 2500 },
              { "color": "#d03b3b", "value": 4000 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true
      },
      "targets": [
        { "expr": "histogram_quantile(0.75, sum by (path_group, le) (rate(web_vitals_lcp_milliseconds_bucket{service=~\"$service\", path_group=~\"$path_group\"}[1h])))", "legendFormat": "{{path_group}}" }
      ]
    },
    {
      "title": "Collector intake",
      "description": "Beacons accepted vs rejected. A sustained non-zero reject line means a config drift or abuse.",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 22 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 0, "pointSize": 8, "spanNulls": true }
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".*(parse_error|label_rejected).*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#d03b3b" } }] }
        ]
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "expr": "sum by (status)(increase(rum_collector_received_total[1h]))", "legendFormat": "{{status}}" }
      ]
    }
  ]
}
