{
  "title": "RUM — Real User Monitoring",
  "uid": "rum-overview",
  "schemaVersion": 39,
  "editable": true,
  "tags": ["rum", "web-vitals"],
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "query": "label_values(rum_pageview_total, service)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "path_group",
        "label": "Path group",
        "type": "query",
        "query": "label_values(rum_pageview_total{service=~\"$service\"}, path_group)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "breakdown",
        "label": "Break down by",
        "description": "Dimension for the Web Vitals breakdown row. Only labels carried by the web_vitals histograms are listed; browser / country / ASN live on the page-load counters instead (see the panel descriptions).",
        "type": "custom",
        "query": "path_group,device,nav_type",
        "options": [
          { "text": "path_group", "value": "path_group", "selected": true },
          { "text": "device", "value": "device", "selected": false },
          { "text": "nav_type", "value": "nav_type", "selected": false }
        ],
        "current": { "text": "path_group", "value": "path_group" }
      }
    ]
  },
  "panels": [
    {
      "title": "LCP p75",
      "description": "Largest Contentful Paint, 75th percentile over the last hour. Good < 2.5s, poor > 4s.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#0ca30c", "value": null },
              { "color": "#fab219", "value": 2500 },
              { "color": "#d03b3b", "value": 4000 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        { "expr": "histogram_quantile(0.75, sum by (le) (increase(web_vitals_lcp_milliseconds_bucket{service=~\"$service\", path_group=~\"$path_group\"}[1h])))", "legendFormat": "LCP p75" }
      ]
    },
    {
      "title": "INP p75",
      "description": "Interaction to Next Paint. Good < 200ms, poor > 500ms.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#0ca30c", "value": null },
              { "color": "#fab219", "value": 200 },
              { "color": "#d03b3b", "value": 500 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        { "expr": "histogram_quantile(0.75, sum by (le) (increase(web_vitals_inp_milliseconds_bucket{service=~\"$service\", path_group=~\"$path_group\"}[1h])))", "legendFormat": "INP p75" }
      ]
    },
    {
      "title": "CLS p75",
      "description": "Cumulative Layout Shift. Good < 0.1, poor > 0.25.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#0ca30c", "value": null },
              { "color": "#fab219", "value": 0.1 },
              { "color": "#d03b3b", "value": 0.25 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        { "expr": "histogram_quantile(0.75, sum by (le) (increase(web_vitals_cls_score_bucket{service=~\"$service\", path_group=~\"$path_group\"}[1h])))", "legendFormat": "CLS p75" }
      ]
    },
    {
      "title": "FCP p75",
      "description": "First Contentful Paint. Good < 1.8s, poor > 3s.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#0ca30c", "value": null },
              { "color": "#fab219", "value": 1800 },
              { "color": "#d03b3b", "value": 3000 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        { "expr": "histogram_quantile(0.75, sum by (le) (increase(web_vitals_fcp_milliseconds_bucket{service=~\"$service\", path_group=~\"$path_group\"}[1h])))", "legendFormat": "FCP p75" }
      ]
    },
    {
      "title": "TTFB p75",
      "description": "Time to First Byte. Good < 800ms, poor > 1.8s.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#0ca30c", "value": null },
              { "color": "#fab219", "value": 800 },
              { "color": "#d03b3b", "value": 1800 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        { "expr": "histogram_quantile(0.75, sum by (le) (increase(web_vitals_ttfb_milliseconds_bucket{service=~\"$service\", path_group=~\"$path_group\"}[1h])))", "legendFormat": "TTFB p75" }
      ]
    },

    {
      "title": "LCP p75 over time",
      "description": "Per service. The 2.5s / 4s guides are the Google good / poor thresholds.",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "pointSize": 8,
            "showPoints": "auto",
            "spanNulls": true,
            "thresholdsStyle": { "mode": "dashed" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "transparent", "value": null },
              { "color": "#fab219", "value": 2500 },
              { "color": "#d03b3b", "value": 4000 }
            ]
          }
        }
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "expr": "histogram_quantile(0.75, sum by (service, le) (increase(web_vitals_lcp_milliseconds_bucket{service=~\"$service\", path_group=~\"$path_group\"}[1h])))", "legendFormat": "{{service}}" }
      ]
    },
    {
      "title": "Page loads per hour",
      "description": "One increment per navigation beacon.",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 5 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "pointSize": 8,
            "showPoints": "auto",
            "spanNulls": true
          }
        }
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "expr": "sum by (service)(increase(rum_pageview_total{service=~\"$service\", path_group=~\"$path_group\"}[1h]))", "legendFormat": "{{service}}" }
      ]
    },

    {
      "type": "row",
      "title": "Composition",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "panels": []
    },
    {
      "title": "LCP rating share",
      "description": "How many page loads were a good experience. Derived from the LCP histogram's rating label — the share of good is the headline number in most RUM reports.",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 15 },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "good" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#0ca30c" } }] },
          { "matcher": { "id": "byName", "options": "needs-improvement" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#fab219" } }] },
          { "matcher": { "id": "byName", "options": "poor" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#d03b3b" } }] }
        ]
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "pieType": "donut",
        "displayLabels": ["name", "percent"],
        "legend": { "showLegend": true, "displayMode": "list", "placement": "right", "values": ["value"] },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        { "expr": "sum by (rating)(increase(web_vitals_lcp_milliseconds_count{service=~\"$service\", path_group=~\"$path_group\"}[1h]))", "legendFormat": "{{rating}}" }
      ]
    },
    {
      "title": "Device share",
      "description": "Share of page loads. Derived from UA-CH; tablets report as mobile in most browsers.",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 15 },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "desktop" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#3987e5" } }] },
          { "matcher": { "id": "byName", "options": "mobile" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#d95926" } }] },
          { "matcher": { "id": "byName", "options": "tablet" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#199e70" } }] },
          { "matcher": { "id": "byName", "options": "unknown" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#c98500" } }] }
        ]
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "pieType": "donut",
        "displayLabels": ["name", "percent"],
        "legend": { "showLegend": true, "displayMode": "list", "placement": "right", "values": ["value"] },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        { "expr": "sum by (device)(increase(rum_pageview_total{service=~\"$service\", path_group=~\"$path_group\"}[1h]))", "legendFormat": "{{device}}" }
      ]
    },
    {
      "title": "Cache status share",
      "description": "Cloudflare cache outcome per page load. Needs the Server-Timing Transform Rule on the service zone, otherwise everything reports as NONE.",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 15 },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "HIT" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#199e70" } }] },
          { "matcher": { "id": "byName", "options": "MISS" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#d95926" } }] },
          { "matcher": { "id": "byName", "options": "DYNAMIC" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#3987e5" } }] },
          { "matcher": { "id": "byName", "options": "EXPIRED" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#c98500" } }] },
          { "matcher": { "id": "byName", "options": "NONE" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#d55181" } }] }
        ]
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "pieType": "donut",
        "displayLabels": ["name", "percent"],
        "legend": { "showLegend": true, "displayMode": "list", "placement": "right", "values": ["value"] },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        { "expr": "sum by (status)(increase(rum_cf_cache_total{service=~\"$service\", path_group=~\"$path_group\"}[1h]))", "legendFormat": "{{status}}" }
      ]
    },
    {
      "title": "Browser share",
      "description": "Share of page loads in the selected window.",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 23 },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "chrome" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#3987e5" } }] },
          { "matcher": { "id": "byName", "options": "safari" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#d95926" } }] },
          { "matcher": { "id": "byName", "options": "firefox" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#199e70" } }] },
          { "matcher": { "id": "byName", "options": "edge" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#c98500" } }] },
          { "matcher": { "id": "byName", "options": "samsung" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#d55181" } }] },
          { "matcher": { "id": "byName", "options": "other" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#008300" } }] }
        ]
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "pieType": "donut",
        "displayLabels": ["name", "percent"],
        "legend": { "showLegend": true, "displayMode": "list", "placement": "right", "values": ["value"] },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        { "expr": "sum by (browser)(increase(rum_pageview_total{service=~\"$service\", path_group=~\"$path_group\"}[1h]))", "legendFormat": "{{browser}}" }
      ]
    },
    {
      "title": "OS share",
      "description": "Share of page loads in the selected window.",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 23 },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "windows" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#3987e5" } }] },
          { "matcher": { "id": "byName", "options": "macos" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#d95926" } }] },
          { "matcher": { "id": "byName", "options": "ios" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#199e70" } }] },
          { "matcher": { "id": "byName", "options": "android" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#c98500" } }] },
          { "matcher": { "id": "byName", "options": "linux" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#d55181" } }] },
          { "matcher": { "id": "byName", "options": "other" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#008300" } }] }
        ]
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "pieType": "donut",
        "displayLabels": ["name", "percent"],
        "legend": { "showLegend": true, "displayMode": "list", "placement": "right", "values": ["value"] },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        { "expr": "sum by (os)(increase(rum_pageview_total{service=~\"$service\", path_group=~\"$path_group\"}[1h]))", "legendFormat": "{{os}}" }
      ]
    },
    {
      "title": "Country share — top 5",
      "description": "Visitor country from the Cloudflare edge (no IP stored). The tail is folded into \"other\" so the slices still sum to all page loads. rum_country_total carries no path_group label, so the Path group filter does not narrow this panel.",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 23 },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "other" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#008300" } }] }
        ]
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "pieType": "donut",
        "displayLabels": ["name", "percent"],
        "legend": { "showLegend": true, "displayMode": "list", "placement": "right", "values": ["value"] },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        { "expr": "topk(5, sum by (country)(increase(rum_country_total{service=~\"$service\"}[1h])))", "legendFormat": "{{country}}" },
        { "expr": "clamp_min(sum(increase(rum_country_total{service=~\"$service\"}[1h])) - sum(topk(5, sum by (country)(increase(rum_country_total{service=~\"$service\"}[1h])))), 0)", "legendFormat": "other" }
      ]
    },
    {
      "title": "Network (ASN) share — top 5",
      "description": "Visitor networks. The tail is folded into \"other\" so the slices still sum to all page loads. rum_asn_total carries no path_group label, so the Path group filter does not narrow this panel.",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 31 },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "other" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#008300" } }] }
        ]
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "pieType": "donut",
        "displayLabels": ["name", "percent"],
        "legend": { "showLegend": true, "displayMode": "list", "placement": "right", "values": ["value"] },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        { "expr": "topk(5, sum by (asn)(increase(rum_asn_total{service=~\"$service\"}[1h])))", "legendFormat": "AS{{asn}}" },
        { "expr": "clamp_min(sum(increase(rum_asn_total{service=~\"$service\"}[1h])) - sum(topk(5, sum by (asn)(increase(rum_asn_total{service=~\"$service\"}[1h])))), 0)", "legendFormat": "other" }
      ]
    },
    {
      "title": "LCP p75 by path group",
      "description": "Which kinds of page are slow. Colored on the same good / poor thresholds as the tile at the top.",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 31 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#0ca30c", "value": null },
              { "color": "#fab219", "value": 2500 },
              { "color": "#d03b3b", "value": 4000 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true
      },
      "targets": [
        { "expr": "histogram_quantile(0.75, sum by (path_group, le) (increase(web_vitals_lcp_milliseconds_bucket{service=~\"$service\", path_group=~\"$path_group\"}[1h])))", "legendFormat": "{{path_group}}" }
      ]
    },

    {
      "type": "row",
      "title": "Web Vitals breakdown — by $breakdown",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 39 },
      "panels": []
    },
    {
      "title": "LCP p75 by $breakdown",
      "description": "Switch the dimension with the \"Break down by\" picker. browser / country / ASN are not available here: the web_vitals histograms carry only service, path_group, device, nav_type and rating, to keep their cardinality flat. Use Loki for those cuts — every beacon logs browser, country and asn alongside the value.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 40 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "pointSize": 8,
            "spanNulls": true,
            "thresholdsStyle": { "mode": "dashed" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "transparent", "value": null },
              { "color": "#fab219", "value": 2500 },
              { "color": "#d03b3b", "value": 4000 }
            ]
          }
        }
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "expr": "histogram_quantile(0.75, sum by ($breakdown, le) (increase(web_vitals_lcp_milliseconds_bucket{service=~\"$service\", path_group=~\"$path_group\"}[1h])))", "legendFormat": "{{$breakdown}}" }
      ]
    },
    {
      "title": "CLS p75 by $breakdown",
      "description": "Cumulative Layout Shift. Guides at the 0.1 / 0.25 thresholds.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 40 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "pointSize": 8,
            "spanNulls": true,
            "thresholdsStyle": { "mode": "dashed" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "transparent", "value": null },
              { "color": "#fab219", "value": 0.1 },
              { "color": "#d03b3b", "value": 0.25 }
            ]
          }
        }
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "expr": "histogram_quantile(0.75, sum by ($breakdown, le) (increase(web_vitals_cls_score_bucket{service=~\"$service\", path_group=~\"$path_group\"}[1h])))", "legendFormat": "{{$breakdown}}" }
      ]
    },
    {
      "title": "INP p75 by $breakdown",
      "description": "Interaction to Next Paint. Guides at the 200ms / 500ms thresholds.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 40 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "pointSize": 8,
            "spanNulls": true,
            "thresholdsStyle": { "mode": "dashed" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "transparent", "value": null },
              { "color": "#fab219", "value": 200 },
              { "color": "#d03b3b", "value": 500 }
            ]
          }
        }
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "expr": "histogram_quantile(0.75, sum by ($breakdown, le) (increase(web_vitals_inp_milliseconds_bucket{service=~\"$service\", path_group=~\"$path_group\"}[1h])))", "legendFormat": "{{$breakdown}}" }
      ]
    },

    {
      "type": "row",
      "title": "Connection",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 48 },
      "panels": []
    },
    {
      "title": "Connection phases p75",
      "description": "Navigation Timing for the HTML document: DNS lookup, TCP connect, TLS handshake, request send, response transfer. Each is its own histogram, all on one millisecond scale.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 49 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "lineWidth": 2, "fillOpacity": 0, "pointSize": 8, "spanNulls": true }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "DNS" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#3987e5" } }] },
          { "matcher": { "id": "byName", "options": "TCP" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#d95926" } }] },
          { "matcher": { "id": "byName", "options": "TLS" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#199e70" } }] },
          { "matcher": { "id": "byName", "options": "request" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#c98500" } }] },
          { "matcher": { "id": "byName", "options": "response" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#d55181" } }] }
        ]
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "expr": "histogram_quantile(0.75, sum by (le)(increase(rum_nav_dns_milliseconds_bucket{service=~\"$service\", path_group=~\"$path_group\"}[1h])))", "legendFormat": "DNS" },
        { "expr": "histogram_quantile(0.75, sum by (le)(increase(rum_nav_tcp_milliseconds_bucket{service=~\"$service\", path_group=~\"$path_group\"}[1h])))", "legendFormat": "TCP" },
        { "expr": "histogram_quantile(0.75, sum by (le)(increase(rum_nav_tls_milliseconds_bucket{service=~\"$service\", path_group=~\"$path_group\"}[1h])))", "legendFormat": "TLS" },
        { "expr": "histogram_quantile(0.75, sum by (le)(increase(rum_nav_request_milliseconds_bucket{service=~\"$service\", path_group=~\"$path_group\"}[1h])))", "legendFormat": "request" },
        { "expr": "histogram_quantile(0.75, sum by (le)(increase(rum_nav_response_milliseconds_bucket{service=~\"$service\", path_group=~\"$path_group\"}[1h])))", "legendFormat": "response" }
      ]
    },
    {
      "title": "Response transfer p75 — by cache status",
      "description": "Does a Cloudflare HIT actually deliver the HTML faster?",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 49 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "lineWidth": 2, "fillOpacity": 0, "pointSize": 8, "spanNulls": true }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "HIT" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#199e70" } }] },
          { "matcher": { "id": "byName", "options": "MISS" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#d95926" } }] },
          { "matcher": { "id": "byName", "options": "DYNAMIC" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#3987e5" } }] },
          { "matcher": { "id": "byName", "options": "NONE" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#d55181" } }] }
        ]
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "expr": "histogram_quantile(0.75, sum by (cf_cache, le)(increase(rum_nav_response_milliseconds_bucket{service=~\"$service\", path_group=~\"$path_group\"}[1h])))", "legendFormat": "{{cf_cache}}" }
      ]
    },
    {
      "title": "Connection phases p75 — HTTP/2 vs HTTP/3",
      "description": "DNS is excluded (it precedes the protocol choice). Useful for spotting whether h3 actually shortens the handshake.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 57 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "lineWidth": 2, "fillOpacity": 0, "pointSize": 8, "spanNulls": true }
        }
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "expr": "histogram_quantile(0.75, sum by (protocol, le)(increase(rum_nav_tcp_milliseconds_bucket{service=~\"$service\", path_group=~\"$path_group\"}[1h])))", "legendFormat": "TCP {{protocol}}" },
        { "expr": "histogram_quantile(0.75, sum by (protocol, le)(increase(rum_nav_tls_milliseconds_bucket{service=~\"$service\", path_group=~\"$path_group\"}[1h])))", "legendFormat": "TLS {{protocol}}" },
        { "expr": "histogram_quantile(0.75, sum by (protocol, le)(increase(rum_nav_response_milliseconds_bucket{service=~\"$service\", path_group=~\"$path_group\"}[1h])))", "legendFormat": "response {{protocol}}" }
      ]
    },
    {
      "title": "HTML transfer size p50 / p75 / p95",
      "description": "Bytes on the wire for the document (transferSize).",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 57 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "lineWidth": 2, "fillOpacity": 0, "pointSize": 8, "spanNulls": true }
        }
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le)(increase(rum_nav_transfer_bytes_bucket{service=~\"$service\", path_group=~\"$path_group\"}[1h])))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.75, sum by (le)(increase(rum_nav_transfer_bytes_bucket{service=~\"$service\", path_group=~\"$path_group\"}[1h])))", "legendFormat": "p75" },
        { "expr": "histogram_quantile(0.95, sum by (le)(increase(rum_nav_transfer_bytes_bucket{service=~\"$service\", path_group=~\"$path_group\"}[1h])))", "legendFormat": "p95" }
      ]
    },
    {
      "title": "Collector intake",
      "description": "Beacons accepted vs rejected. A sustained non-zero reject line means a config drift or abuse. rum_collector_received_total has no service label, so this panel is fleet-wide.",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 65 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 0, "pointSize": 8, "spanNulls": true }
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".*(parse_error|label_rejected).*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#d03b3b" } }] }
        ]
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "expr": "sum by (status)(increase(rum_collector_received_total[1h]))", "legendFormat": "{{status}}" }
      ]
    }
  ]
}
