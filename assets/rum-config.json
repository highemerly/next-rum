{
  "services": {
    "handon.club":      "handon",
    "dev.handon.club":  "handon-dev",
    "hosteka.piyo.me":  "hosteka",
    "mi.hiyoko.club":   "hiyoko",
    "pic.handon.club":  "movapic-neo",
    "anypost.dev":      "anypost"
  },
  "default_service": "unknown",
  "default_path_group": "other",
  "path_groups": {
    "handon": [
      { "pattern": "/",          "group": "home" },
      { "pattern": "/web",       "group": "web_ui" },
      { "pattern": "/web/**",    "group": "web_ui" },
      { "pattern": "/@*",        "group": "profile" },
      { "pattern": "/@*/**",     "group": "status" },
      { "pattern": "/tags/**",   "group": "tag" },
      { "pattern": "/about**",   "group": "about" },
      { "pattern": "/explore**", "group": "explore" },
      { "pattern": "/public**",  "group": "public_tl" }
    ],
    "handon-dev": [
      { "pattern": "/",       "group": "home" },
      { "pattern": "/web/**", "group": "web_ui" }
    ],
    "hiyoko": [
      { "pattern": "/",           "group": "home" },
      { "pattern": "/@*",         "group": "profile" },
      { "pattern": "/notes/**",   "group": "note" },
      { "pattern": "/channels/**","group": "channel" }
    ],
    "movapic-neo": [
      { "pattern": "/",                "group": "home" },
      { "pattern": "/create**",        "group": "create" },
      { "pattern": "/public",          "group": "timeline" },
      { "pattern": "/favorite",        "group": "timeline" },
      { "pattern": "/u/*/status/**",   "group": "photo" },
      { "pattern": "/u/*",             "group": "user" },
      { "pattern": "/u/*/**",          "group": "user" },
      { "pattern": "/notifications",   "group": "notifications" },
      { "pattern": "/dashboard",       "group": "dashboard" },
      { "pattern": "/settings**",      "group": "settings" },
      { "pattern": "/docs**",          "group": "docs" },
      { "pattern": "/announcements**", "group": "announcements" },
      { "pattern": "/stats",           "group": "stats" },
      { "pattern": "/terms",           "group": "legal" },
      { "pattern": "/privacy",         "group": "legal" },
      { "pattern": "/license",         "group": "legal" },
      { "pattern": "/admin/**",        "group": "admin" }
    ],
    "anypost": [
      { "pattern": "/",       "group": "home" },
      { "pattern": "/posts/**","group": "post" }
    ],
    "hosteka": [
      { "pattern": "/", "group": "home" }
    ],
    "*": [
      { "pattern": "/", "group": "home" }
    ]
  }
}
